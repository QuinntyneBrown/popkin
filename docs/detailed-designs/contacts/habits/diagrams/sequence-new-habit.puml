@startuml
title UML sequence behaviour — New habit
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "NewHabitDialog" as page
  participant "HabitsStore" as store
  participant "ContactsOutbox" as outbox
  participant "HttpContactsApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "HabitsController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "StartHabitCommandHandler" as handler
  participant "IContactGuard" as second
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
actor -> page : "New habit"
page --> actor : "With" Ifeoma Okafor, "Change", "What", "How often", "Start the habit" (L2-145 AC1)
actor -> page : "Start the habit" with "What" empty
page --> actor : "One thing to fix", "What: say what you’ll do together." (L2-145 AC2)
actor -> page : "Sunday call", "Weekly", "Start the habit"
page --> actor : "Starting…"
page -> store : start(request)
store -> outbox : POST with a new clientId
outbox -> client : startHabit({ clientId, contactId, what, rhythm })
client -> controller : POST /api/contacts/habits
controller -> handler : Send StartHabitCommand
handler -> second : RequireOwnedAsync(contactId)
alt Not the person's contact
  second --> controller : 404 contact_not_found
else Owned
  handler -> handler : HabitRules.What: 400 what_required; rhythm: 400 rhythm_not_allowed
  handler -> db : Add Habit (StartedOn = today), SaveChangesAsync
  handler --> controller : HabitDto
  controller --> client : 201
  client --> store : Add the habit
  page --> actor : Dialog closes; the habit shows on Habits and the profile (L2-145 AC3)
end
@enduml
