@startuml
title UML sequence behaviour — Marking a follow-up done, and Undo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "ContactsFollowUpsPage" as page
  participant "FollowUpsStore" as store
  participant "ContactsOutbox" as outbox
  participant "HttpContactsApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "FollowUpsController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "SetFollowUpDoneCommandHandler" as handler
  participant "FollowUp" as second
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
actor -> page : "Mark done: Return Ruth’s ladder"
page -> store : setDone(id, true)
store --> page : Struck through at once (L2-142 AC2)
store -> outbox : PUT done = true
outbox -> client : setFollowUpDone(id, true)
client -> controller : PUT /api/contacts/follow-ups/{id}/done
controller -> handler : Send SetFollowUpDoneCommand
handler -> db : Load the follow-up for PersonId
alt Another person's
  handler --> controller : 404 follow_up_not_found
else The owner's
  handler -> second : MarkDone(now)
  handler -> db : SaveChangesAsync
  handler --> controller : FollowUpDto
end
alt Save fails
  controller --> client : Error
  client --> store : failed
  store --> page : Row open again
  page --> actor : Danger toast "We couldn’t save that follow-up", "Try again" (L2-124 AC3)
else Saved
  controller --> client : 200
  page --> actor : Toast "Marked done", "Return Ruth’s ladder.", "Undo", 8 s (L2-124 AC2, AC4)
  opt "Undo", or "Mark not done: {text}"
    actor -> page : Undo
    page -> store : setDone(id, false)
    store -> outbox : PUT done = false
    outbox -> client : setFollowUpDone(id, false)
    client -> controller : PUT /api/contacts/follow-ups/{id}/done
    controller -> handler : Send SetFollowUpDoneCommand
    handler -> second : MarkNotDone()
    handler -> db : SaveChangesAsync
    page --> actor : Open again (L2-142 AC3)
  end
end
@enduml
