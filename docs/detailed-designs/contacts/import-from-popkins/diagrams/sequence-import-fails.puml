@startuml
title UML sequence behaviour — An import is refused or fails
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "ImportContactsDialog" as dialog
  participant "ImportContactsStore" as store
  participant "HttpContactsApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "ContactsImportController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "ImportContactsCommandHandler" as handler
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
alt Nobody ticked
  actor -> dialog : "Tick nobody"
  dialog -> store : tickNobody()
  store --> dialog : count 0
  dialog --> actor : "Import nobody", disabled (L2-151 AC3)
else Not now
  actor -> dialog : "Not now"
  dialog --> actor : Closes; nothing imported (L2-151 AC5)
else Sent
  actor -> dialog : "Import {n} people"
  store -> client : importPeople(clientId, personIds)
  client -> controller : POST /api/contacts/import
  controller -> handler : Send ImportContactsCommand
  handler -> db : Recompute the candidates
  alt An id is not a candidate (L2-122 AC1)
    handler --> controller : 400 import_person_not_shared
  else Save fails
    handler -> db : SaveChangesAsync
    db --> handler : Exception; nothing written
    handler --> controller : 500
  end
  controller --> client : ProblemDetails
  client --> store : importFailed
  store --> dialog : Ticks kept
  dialog --> actor : Alert <TO SUPPLY>; dialog stays open
end
@enduml
