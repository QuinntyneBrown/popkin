@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Open Contacts

Person(owner, "Signed-in person", "Owner of their Contacts")
System_Boundary(popkin, "Popkin") {
  Container(web, "Popkin web app", "Angular SPA", "Contacts button on My Popkins, Contacts navigation, ContactsOutbox in local storage")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "/api/contacts/**, owner only, no hub events")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Contact, FollowUp and the other Contacts tables, each with OwnerId")
}
Rel(owner, web, "Opens Contacts", "HTTPS")
Rel(web, api, "GET /api/contacts/summary, GET /api/contacts/follow-ups; Contacts writes with clientId", "JSON/HTTPS, session")
Rel(api, db, "Reads and saves the owner's rows", "EF Core")
@enduml
