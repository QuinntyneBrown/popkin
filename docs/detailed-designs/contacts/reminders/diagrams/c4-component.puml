@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Reminders

Container_Boundary(worker, "Popkin Worker") {
  Component(job, "SendContactRemindersJob", "PeriodicJob, 5 min", "Sends one command per tick")
}
Container_Boundary(app, "Popkin Application") {
  Component(handler, "SendContactRemindersCommandHandler", "MediatR handler", "From 8 am local: adds reminders and Birthdays events once")
  Component(rules, "ReminderRules", "Pure type", "Hour 8; words; what is due")
  Component(metrics, "PopkinMetrics", "Meter Popkin", "In-app reminders added")
  Component(dispatch, "DispatchNotificationsCommandHandler", "MediatR handler", "Sends the event (Deliver notifications)")
}
Container_Boundary(api, "Popkin API") {
  Component(ctrl, "ContactRemindersController", "ASP.NET Core controller", "GET reminders, POST dismissal")
  Component(read, "GetContactRemindersQueryHandler", "MediatR handler", "Owner's undismissed reminders")
  Component(dismiss, "DismissContactReminderCommandHandler", "MediatR handler", "Dismisses one")
}
ComponentDb(db, "Popkin database", "SQL Server", "ContactReminder, NotificationEvent")
Rel(job, handler, "Sends SendContactRemindersCommand")
Rel(handler, rules, "Uses")
Rel(handler, db, "Reads due dates; writes reminders and events in one save", "EF Core")
Rel(handler, metrics, "Records")
Rel(dispatch, db, "Reads the Birthdays events", "EF Core")
Rel(ctrl, read, "Sends GetContactRemindersQuery")
Rel(ctrl, dismiss, "Sends DismissContactReminderCommand")
Rel(read, db, "Reads", "EF Core")
Rel(dismiss, db, "Writes", "EF Core")
@enduml
