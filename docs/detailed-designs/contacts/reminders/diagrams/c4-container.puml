@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Reminders

Person(owner, "Person", "Owner of the reminders")
System_Boundary(popkin, "Popkin") {
  Container(web, "Popkin web app", "Angular", "Shows in-app reminders as toasts")
  Container(api, "Popkin API", "ASP.NET Core", "Reads and dismisses reminders")
  Container(worker, "Popkin Worker", ".NET worker", "SendContactRemindersJob; DispatchNotificationsJob sends email and phone")
  ContainerDb(db, "Popkin database", "SQL Server", "KeyDate, ContactReminder, NotificationEvent, NotificationPreferences")
}
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Reads and dismisses reminders", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Adds ContactReminder and its Birthdays event once", "EF Core")
@enduml
