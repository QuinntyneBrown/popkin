@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Reminders

package "Popkin.Domain" {
  enum ReminderKind {
    KeyDate
    FollowUp
    Habit
  }
  class ContactReminder {
    +Guid Id
    +Guid OwnerId
    +ReminderKind Kind
    +Guid SubjectId
    +Guid? ContactId
    +DateOnly DueOn
    +string Words
    +DateTimeOffset CreatedAt
    +DateTimeOffset? NotifiedAt
    +DateTimeOffset? DismissedAt
    +Dismiss(now: DateTimeOffset): void
    +MarkNotified(now: DateTimeOffset): void
  }
  class KeyDate {
    +Guid Id
    +ReminderLead Lead
    +bool RemindersOn
    +NextOccurrence(today: DateOnly): DateOnly?
    +ReminderDay(occursOn: DateOnly): DateOnly
  }
  class ReminderPreferences {
    +ReminderLead BirthdayLead
    +ReminderLead AnniversaryLead
    +ReminderLead MilestoneLead
  }
  class NotificationPreferences {
    +Guid PersonId
    +string? TimeZone
  }
  class NotificationEvent {
    +NotificationKind Kind
    +Guid? RecipientPersonId
    +Guid SubjectId
    +string? Facts
    +string? DedupKey
  }
}
package "Popkin.Application" {
  class SendContactRemindersCommand
  class SendContactRemindersCommandHandler {
    +Handle(command: SendContactRemindersCommand): Task<int>
  }
  class ReminderRules {
    +{static} Hour: int = 8
    +{static} LocalNow(zone: string?, utcNow): DateTimeOffset
    +{static} IsTime(localNow): bool
    +{static} DateWords(date, firstName, occursOn, today): string
    +{static} FollowUpWords(text): string
    +{static} HabitWords(what, firstName, overdue): string
  }
  class GetContactRemindersQueryHandler {
    +Handle(query: GetContactRemindersQuery): Task<ContactReminderDto[]>
  }
  class DismissContactReminderCommandHandler {
    +Handle(command: DismissContactReminderCommand): Task
  }
}
package "Popkin.Worker" {
  abstract class "PeriodicJob<TResponse>" as PeriodicJob {
    #NewCommand(): IRequest<TResponse>
  }
  class SendContactRemindersJob {
    #NewCommand(): IRequest<int>
  }
}
PeriodicJob <|-- SendContactRemindersJob
SendContactRemindersJob ..> SendContactRemindersCommand : sends
SendContactRemindersCommandHandler ..> SendContactRemindersCommand : handles
SendContactRemindersCommandHandler ..> ReminderRules
SendContactRemindersCommandHandler ..> KeyDate : reads RemindersOn
SendContactRemindersCommandHandler ..> NotificationPreferences : reads TimeZone
SendContactRemindersCommandHandler --> ContactReminder : adds once
SendContactRemindersCommandHandler --> NotificationEvent : adds Birthdays once
ContactReminder --> ReminderKind
DismissContactReminderCommandHandler --> ContactReminder : dismisses
GetContactRemindersQueryHandler ..> ContactReminder : reads
KeyDate ..> ReminderPreferences : lead starts from default
@enduml
