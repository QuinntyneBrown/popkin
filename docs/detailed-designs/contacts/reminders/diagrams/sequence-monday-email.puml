@startuml
title UML sequence behaviour — Monday email
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "TimeProvider" as time
box "Backend — Popkin Worker" #D1FADF
  participant "SendContactRemindersJob" as job
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "SendContactRemindersCommandHandler" as handler
  participant "IOwnerClock" as clock
  participant "IContactsEmailSender" as mail
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
  participant "Azure Communication Services" as acs
end box
time -> job : Period elapses
job -> handler : Send SendContactRemindersCommand
loop Each owner
  handler -> clock : LocalNow(ownerId)
  clock --> handler : Monday, hour <TO SUPPLY>
  opt MondayEmail on and no ContactWeeklyEmail for this week (L2-140 AC3)
    handler -> db : Key dates occurring in the week ahead
    db --> handler : Rows
    handler -> mail : SendWeekAheadAsync(owner's email, WeekAheadEmail)
    mail -> acs : Send email
    acs --> mail : Accepted
    handler -> db : Add ContactWeeklyEmail(ownerId, weekOf); save
    db --> handler : Committed
  end
end
handler --> job : ContactRemindersResult
@enduml
