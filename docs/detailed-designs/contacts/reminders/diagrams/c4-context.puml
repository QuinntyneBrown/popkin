@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title System Context — Reminders

Person(owner, "Person", "Keeps their own Contacts; the only one who sees them")
System(popkin, "Popkin", "Platform for pop-up communities, with Contacts")
System_Ext(acs, "Azure Communication Services", "Sends Popkin's email (ADR 0021)")
System_Ext(push, "Phone notification service", "<TO SUPPLY>: the channel needs its own ADR")
Rel(owner, popkin, "Uses Contacts in", "HTTPS")
Rel(popkin, acs, "Sends the Monday email via", "HTTPS")
Rel(popkin, push, "Sends phone notifications via", "<TO SUPPLY>")
Rel(acs, owner, "Delivers the email to")
Rel(push, owner, "Notifies at 9 am")
@enduml
