@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — People

Person(owner, "Owner", "Signed-in person")
System_Boundary(popkin, "Popkin") {
  Container(web, "Popkin web app", "Angular SPA", "ContactsPeoplePage, PeopleStore; search and circles on the device")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "GET /api/contacts/people, owner only")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Contact, KeyDate, TimelineEntry")
}
Rel(owner, web, "Opens People", "HTTPS")
Rel(web, api, "GET /api/contacts/people?on={device day}", "JSON/HTTPS, session")
Rel(api, db, "Reads the owner's contacts", "EF Core")
@enduml
