@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Wrap up a Popkin now

Person(admin, "Admin", "Owner, Support or Viewer")
Person(member, "Member", "Person who belongs to a Popkin")
System_Boundary(popkin, "Popkin") {
  Container(adminApp, "Popkin admin app", "Angular", "frontend/projects/admin at admin.popkin.community")
  Container(webApp, "Popkin web app", "Angular", "frontend/projects/popkin")
  Container(api, "Popkin API", "ASP.NET Core", "/api/admin/** controllers, /api controllers and PopkinHub")
  ContainerDb(db, "Popkin database", "SQL Server", "Popkins, memberships and audit entries")
}
Rel(admin, adminApp, "Uses", "HTTPS")
Rel(member, webApp, "Uses", "HTTPS")
Rel(adminApp, api, "POST /api/admin/popkins/{popkinId}/wrap-up", "JSON/HTTPS, admin session cookie")
Rel(api, db, "Saves the wrap-up, ended calls and audit entry in one transaction", "EF Core")
Rel(api, webApp, "PopkinWrappedUp, CallEnded", "SignalR, PopkinHub")
Rel(webApp, api, "GET /api/popkins/{popkinId} recovery read", "JSON/HTTPS")
@enduml
