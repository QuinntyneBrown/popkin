@startuml
title UML sequence behaviour — Mute or turn the camera off
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "pk-call-controls" as controls
  participant "VideoCallPage" as page
  participant "CallSession" as session
  participant "CallsApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "CallsController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "SetCallMediaCommandHandler" as handler
  participant "CallParticipant" as part
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
  participant "SignalRPopkinNotifier" as notifier
end box
actor "Other participants" as others

actor -> controls : Press "Mute" or "Camera" (touch, Space or Enter)
controls -> page : toggleMic / toggleCamera
page -> session : toggleMic()
session -> session : Set the local audio or video track enabled = false at once
session --> page : micOn false
page --> actor : aria-pressed true, label "Unmute" or "Camera off", icon changed, fill inverted (L2-030 AC5)
session -> client : PATCH /api/popkins/{popkinId}/calls/{callId}/participants/me {micOn: false}
client -> controller : HTTPS request
controller -> handler : Send SetCallMediaCommand
handler -> db : Load the caller's CallParticipant with LeftAt null
alt Not on the call, or not a member
  controller --> client : 404 ProblemDetails code call_not_found or popkin_not_found (L2-051 AC1)
  client --> session : Failure
  session --> page : Keep the track off locally; status shown TO SUPPLY
else On the call
  handler -> part : SetMedia(micOn false)
  handler -> db : Save changes
  handler -> notifier : ParticipantMediaChanged to call:{callId}
  controller --> client : 204 No Content
  notifier --> others : Muted microphone icon beside the name (L2-030 AC3)\nor avatar instead of video (L2-030 AC2)
end
@enduml
