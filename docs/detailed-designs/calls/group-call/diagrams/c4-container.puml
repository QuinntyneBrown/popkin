@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Start or join a group call

Person(member, "Member", "Belongs to the Popkin")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "Video call page, call banner, WebRTC media session")
  Container(api, "Popkin API", "ASP.NET Core (.NET 10)", "CallsController and the PopkinHub signalling hub at /hubs/popkin")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Calls, call participants, memberships")
}
System_Ext(relay, "Media relay", "STUN/TURN, provider TO SUPPLY")

Rel(member, spa, "Uses", "HTTPS")
Rel(spa, api, "Starts, joins and leaves calls", "JSON/HTTPS")
Rel(spa, api, "Exchanges offers, answers and ICE candidates; receives call events", "SignalR/WebSocket")
Rel(api, db, "Reads and writes calls", "EF Core")
Rel(spa, relay, "Sends and receives audio and video", "WebRTC SRTP over STUN/TURN")
Rel(api, relay, "Issues short-lived relay credentials for", "TO SUPPLY")
@enduml
