@startuml
title UML sequence behaviour — One hour left
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or Host" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "PopkinHomePage" as page
  participant "CurrentPopkinStore" as store
  participant "TimeLeftClock" as clock
  participant "formatTimeLeft" as fmt
  participant "ChangeLengthDialog" as dialog
end box
box "Backend — Popkin API" #D1FADF
  participant "PopkinsController" as controller
end box
actor -> page : Open Popkin home
page -> store : load(popkinId)
store -> controller : GET /api/popkins/{popkinId}
controller --> store : endsAt, status, isHost
loop every 30 s
  clock -> store : now
  store -> fmt : formatTimeLeft(endsAt, now)
  fmt --> store : "1 day 6 hrs left" or "42 min left"
  store --> page : Time left label (L2-044 AC5)
end
alt endsAt is null
  page --> actor : No time left, no warning (L2-044 AC3)
else 0 < endsAt - now <= 60 min
  store --> page : wrapUpWarning = true
  alt isHost
    page --> actor : Warning banner "1 hour left." with "Change"
    actor -> page : Choose "Change"
    page -> dialog : Open with CDK Dialog
  else member
    page --> actor : Warning banner "1 hour left." without action (L2-044 AC2)
  end
end
@enduml
