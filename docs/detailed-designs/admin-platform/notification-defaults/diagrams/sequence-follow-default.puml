@startuml
title UML sequence behaviour — Members follow a new default
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member A (never chose)" as a
actor "Member B (chose As it happens)" as b
box "Frontend — Popkin web app" #E0F2FE
  participant "Notifications screen, Add a date" as web
end box
box "Backend — Popkin API" #D1FADF
  participant "Settings and key-date handlers" as api
end box
box "Backend — Popkin Worker" #FFF4E5
  participant "NotificationRules" as rules
  participant "PlatformSnapshot (Worker)" as snap
  database "Popkin database" as db
end box
== Within a minute of the save (L2-173 AC4) ==
a -> web : Opens Notifications
web -> api : Member settings
api -> db : NotificationPreferences.Frequency = null
api -> api : Frequency ?? Defaults.DefaultFrequency
api --> web : "Daily digest" chosen
b -> web : Opens Notifications
api -> db : Frequency = AsItHappens
api --> web : "As it happens", kept
a -> web : Adds a birthday
api -> db : ReminderPreferences.BirthdayLead = null
api -> api : Lead = Defaults.BirthdayLead; "Off" sets RemindersOn false (L2-139 AC4)
== Next dispatcher tick ==
rules -> snap : RefreshIfStaleAsync; Defaults
snap -> db : Reload NotificationPlatform
rules -> rules : Bundling window, daily most, quiet hours for every person (L2-161)
rules -> rules : Member A gets the 6 pm digest; member B gets one email per change
@enduml
