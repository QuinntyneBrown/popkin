@startuml
title UML sequence behaviour — Edit a comment
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "ExperienceDetailPage" as page
  participant "AddCommentDialog" as dialog
  participant "HttpExperiencesApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "ExperiencesController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "CommentOnExperienceCommandHandler" as handler
  participant "ExperienceRating" as rating
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
actor -> page : Choose "Edit your comment" (placement TO SUPPLY)
page -> dialog : Open with title, my stars and existingText
dialog --> actor : "Your comment" filled with the current text (L2-041 AC4)
actor -> dialog : Change text, choose "Post comment"
dialog -> client : comment(popkinId, experienceId, newText)
client -> controller : PUT .../my-rating/comment {text}
controller -> handler : Send CommentOnExperienceCommand
handler -> db : Load the caller's rating
db --> handler : ExperienceRating with Comment
handler -> rating : SetComment(newText, now) replaces the text and CommentedAt
handler -> db : Save changes
handler --> controller : ExperienceCommentDto
controller --> client : 200 JSON
client --> dialog : ExperienceCommentView
dialog --> page : Close
page -> page : Remove the old entry, put the new one first
page --> actor : One comment by the member, with the new text (L2-041 AC4)
@enduml
