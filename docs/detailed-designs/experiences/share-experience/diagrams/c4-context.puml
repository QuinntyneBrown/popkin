@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Share an experience

Person(member, "Member", "Shares, edits and deletes their own experiences")
Person(host, "Host", "Member who started the Popkin; may delete any experience")
