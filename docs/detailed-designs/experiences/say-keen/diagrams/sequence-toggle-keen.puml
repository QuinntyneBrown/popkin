@startuml
title UML sequence behaviour — Say you are keen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "ExperienceDetailPage" as page
  participant "HttpExperiencesApi" as client
  participant "Toaster" as toaster
end box
box "Backend — Popkin API" #D1FADF
  participant "ExperiencesController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "SetKeenCommandHandler" as handler
  participant "IMembershipGuard" as guard
  participant "Experience" as entity
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
actor -> page : Open a Want to do experience
page --> actor : "Keen to do this?", up to four avatars and "+3", "7 keen", "I'm keen" aria-pressed=false (L2-042 AC1)
actor -> page : Choose "I'm keen" (or "You're keen" to undo)
page -> page : Disable the button while the request runs (L2-056 AC3)
alt Becoming keen
  page -> client : setKeen(popkinId, experienceId, true)
  client -> controller : PUT /api/popkins/{popkinId}/experiences/{experienceId}/keen
else No longer keen
  page -> client : setKeen(popkinId, experienceId, false)
  client -> controller : DELETE /api/popkins/{popkinId}/experiences/{experienceId}/keen
end
controller -> handler : Send SetKeenCommand(Keen)
handler -> guard : RequireMembershipAsync(popkinId)
alt Not a member
  controller --> client : 404 ProblemDetails code popkin_not_found (L2-051 AC1)
else Member
  handler -> db : Load PopkinSpace, Experience and the caller's keen record
  alt Popkin wrapped up
    controller --> client : 409 ProblemDetails code popkin_wrapped_up (L2-045 AC2)
  else Kind is not Want to do
    controller --> client : 409 ProblemDetails code experience_not_wanted
  else Allowed
    handler -> entity : AddKeen(membershipId, now) or RemoveKeen(membershipId)
    entity --> handler : No change when already in that state
    handler -> db : Save changes
    handler -> db : Count and first four keen members
    db --> handler : KeenDto
    controller --> client : 200 JSON
    client --> page : KeenView
    alt Now keen
      page --> actor : Button aria-pressed=true reads "You're keen", count up by one (L2-042 AC2)
    else No longer keen
      page --> actor : Button aria-pressed=false reads "I'm keen", count down by one (L2-042 AC3)
    end
  end
end
alt Refusal or network failure
  client --> page : Error
  page -> page : Keep the previous state, enable the button
  page -> toaster : Danger toast (copy TO SUPPLY)
end
@enduml
