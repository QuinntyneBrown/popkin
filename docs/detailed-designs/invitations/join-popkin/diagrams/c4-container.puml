@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Join a Popkin

Person(joiner, "Member (joining)", "Signed in")
Person(others, "Members", "Have the Popkin open")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "your-profile, youre-in, member-joined toast")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "POST /api/invites/(code)/join, PopkinHub")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Membership, Message")
  Container(store, "Photo store", "Object storage, provider TO SUPPLY", "Profile photo")
}
Rel(joiner, spa, "Uses", "HTTPS")
Rel(others, spa, "Use", "HTTPS")
Rel(spa, api, "Joins", "multipart/form-data over HTTPS")
Rel(api, store, "Stores the photo")
Rel(api, db, "Inserts membership and system message", "EF Core")
Rel(api, spa, "Pushes MemberJoined and MessageSent", "SignalR")
@enduml
