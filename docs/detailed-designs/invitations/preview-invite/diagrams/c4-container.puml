@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Preview an invite

Person(visitor, "Visitor or signed-in person", "Opens /i/(code)")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "join-invite page")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "GET /api/invites/(code), anonymous, rate limited")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "PopkinSpace by InviteCode, Membership")
  Container(store, "Photo store", "Object storage, provider TO SUPPLY", "Avatar photos")
}
Rel(visitor, spa, "Uses", "HTTPS")
Rel(spa, api, "Reads the preview", "JSON/HTTPS")
Rel(api, db, "Reads", "EF Core")
Rel(spa, store, "Loads avatars", "expiring signed URLs")
@enduml
