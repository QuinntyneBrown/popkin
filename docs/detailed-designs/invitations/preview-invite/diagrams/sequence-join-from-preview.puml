@startuml
title UML sequence behaviour — Choose Join on an invite
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "JoinInvitePage" as page
  participant "JoinInviteState" as state
  participant "AuthApi" as auth
  participant "Router" as router
end box
actor -> page : Choose "Join"
page -> state : Keep preview for the profile step
page -> auth : Is there a session?
alt signed in
  page -> router : navigate /i/(code)/profile
else visitor (L2-012 AC3)
  page -> router : navigate /sign-up with returnUrl=/i/(code)/profile
  router --> actor : Sign up or sign in, confirm the code (L2-003 to L2-006)
  actor -> router : Code confirmed
  router -> router : Read returnUrl, accept only same-origin app paths
  router --> actor : navigate /i/(code)/profile without opening the link again
end
@enduml
