@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Invite people

Container_Boundary(spa, "Popkin web app") {
  Component(home, "PopkinHomePage / PopkinSettingsDialog", "Angular page and dialog", "Invite and Invite people entry points")
  Component(dlg, "InviteDialog", "CDK dialog", "Bring someone in")
  Component(qr, "pk-qr-card", "components library", "QR code, emoji, name, link")
  Component(enc, "QrEncoder", "Api library helper", "Encodes the link, library TO SUPPLY")
  Component(papi, "PopkinsApi", "Contract + HTTP client", "getInvite(id)")
}
Container_Boundary(api, "Popkin API") {
  Component(ctrl, "PopkinsController", "Controller", "GET /api/popkins/(id)/invite")
  Component(handler, "GetInviteQueryHandler", "MediatR handler", "Member only")
  Component(link, "InviteLinkBuilder", "Application service", "Invites:BaseUrl + code")
  Component(guard, "IMembershipGuard", "Abstraction", "404 for non-members")
  ComponentDb(db, "AppDbContext", "EF Core", "Popkin database")
}
Rel(home, dlg, "Opens with CDK Dialog")
Rel(dlg, papi, "getInvite()")
Rel(dlg, enc, "Encodes link")
Rel(dlg, qr, "Renders")
Rel(papi, ctrl, "HTTPS")
Rel(ctrl, handler, "GetInviteQuery")
Rel(handler, guard, "Requires membership")
Rel(handler, link, "Builds URL")
Rel(handler, db, "Reads PopkinSpace")
@enduml
