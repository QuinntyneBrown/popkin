@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members

title Class structure — Send a message to everyone

package "Popkin.Domain" {
  enum ChatThreadKind {
    Everyone
    Direct
  }
  enum MessageKind {
    Member
    System
  }
  class ChatThread {
    +Guid Id
    +Guid PopkinId
    +ChatThreadKind Kind
    +DateTimeOffset CreatedAt
  }
  class Message {
    +Guid Id
    +Guid ThreadId
    +Guid AuthorMembershipId
    +string Text
    +Guid? ClientMessageId
    +DateTimeOffset SentAt
    +MessageKind Kind
    +DateTimeOffset? DeletedAt
    +{static} MaxTextLength = 2000
    +{static} Send(threadId, authorMembershipId, text, clientMessageId, now): Message
    +{static} PoppedIn(threadId, joiner): Message
    +Delete(now): void
  }
  class PopkinSpace {
    +Guid Id
    +string Name
    +string Emoji
    +PopkinStatus Status
  }
}
package "Popkin.Application" {
  class SendMessageCommand {
    +Guid PopkinId
    +Guid ThreadId
    +Guid? ClientMessageId
    +string? Text
  }
  class SendMessageCommandHandler {
    +Handle(cmd: SendMessageCommand): Task<SendMessageResult>
  }
  class GetEveryoneThreadQueryHandler {
    +Handle(q: GetEveryoneThreadQuery): Task<ThreadDto>
  }
  class GetMessagesQueryHandler {
    +PageSize = 50
    +Handle(q: GetMessagesQuery): Task<MessagePageDto>
  }
  class ThreadDto {
    +Guid Id
    +Guid PopkinId
    +ChatThreadKind Kind
    +string PopkinName
    +string Emoji
    +PopkinColour Colour
    +DateTimeOffset? EndsAt
    +int MemberCount
    +int HereNow
    +long PresenceVersion
    +bool ReadOnly
    +int UnreadCount
    +Guid? LastReadMessageId
    +ThreadViewerDto Viewer
  }
  class MessageDto {
    +Guid Id
    +Guid ThreadId
    +Guid? ClientMessageId
    +MessageKind Kind
    +MessageAuthorDto Author
    +string Text
    +DateTimeOffset SentAt
  }
  interface IMembershipGuard
  interface IPopkinNotifier
  interface IAppDbContext
}
package "Popkin.Api" {
  class MessagesController {
    +Get(popkinId, threadId, before?, after?, from?, to?, limit?): MessagePageDto
    +Send(popkinId, threadId, request): MessageDto
    +Discard(popkinId, threadId, clientMessageId): 204
  }
  class ThreadsController {
    +GetEveryone(popkinId): ThreadDto
    +MarkRead(popkinId, threadId, request): 204
  }
}
package "web app (popkin, api, components)" {
  class GroupChatPage {
    +text: Signal<string>
    +send(text: string): void
    +useOpener(opener: string): void
  }
  class ThreadStore {
    +thread: Signal<ThreadView | null>
    +rows: Signal<ThreadRow[]>
    +state: Signal<ThreadState>
    +open(popkinId): void
    +send(text): void
    +loadEarlier(): Promise<void>
  }
  interface ChatApi {
    +getEveryone(popkinId): Observable<ThreadView>
    +getMessages(popkinId, threadId, cursor?): Observable<MessagePageView>
    +send(popkinId, threadId, clientMessageId, text): Observable<MessageView>
  }
  class HttpChatApi
}
ChatThread "1" *-- "*" Message : holds
ChatThread --> ChatThreadKind
Message --> MessageKind
SendMessageCommandHandler ..> SendMessageCommand : handles
SendMessageCommandHandler ..> IMembershipGuard
SendMessageCommandHandler ..> IAppDbContext
SendMessageCommandHandler ..> IPopkinNotifier
SendMessageCommandHandler ..> PopkinSpace : reads Status
SendMessageCommandHandler --> Message : creates
SendMessageCommandHandler ..> MessageDto : returns
GetEveryoneThreadQueryHandler ..> ThreadDto : returns
MessagesController ..> SendMessageCommandHandler : MediatR
MessagesController ..> GetMessagesQueryHandler : MediatR
ThreadsController ..> GetEveryoneThreadQueryHandler : MediatR
GroupChatPage --> ThreadStore
ThreadStore ..> ChatApi : CHAT_API
HttpChatApi ..|> ChatApi
@enduml
