@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send a message to everyone

Person(member, "Member", "Signed-in person who belongs to a Popkin")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "Group chat page, composer and thread view")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "Threads and messages endpoints; PopkinHub at /hubs/popkin")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Threads, messages, memberships")
}
Rel(member, spa, "Uses", "HTTPS")
Rel(spa, api, "Loads the thread and posts messages", "JSON/HTTPS")
Rel(api, spa, "Pushes MessageAdded to members", "SignalR WebSocket")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
