@startuml
title UML sequence behaviour — Open the real-time connection
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam maxMessageSize 260
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "Pages" as page
  participant "ThreadStore /\nUnreadTracker" as store
  participant "SignalRPopkinRealtime" as rt
end box
box "Backend — Popkin API" #D1FADF
  participant "PopkinHub" as hub
  participant "PresenceTracker" as presence
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "Application" as handler
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
actor -> page : Open a thread
page -> store : open(popkinId); the thread and its latest page are read
store -> rt : start()
rt -> hub : POST /hubs/popkin/negotiate, then WebSocket upgrade with session cookie
hub -> hub : SameSiteRequestMiddleware: the app's own origin only; [Authorize]
alt no valid session (L2-050 AC4)
  hub --> rt : 401
  rt --> page : The start fails and is tried again after 2, 10, 30 s, then every 30 s
else valid session
  hub -> handler : Send ConnectToHubCommand(personId, connectionId)
  handler -> db : Membership where LeftAt is null
  db --> handler : Popkin ids
  handler -> hub : IPopkinConnections.AddToPopkinAsync(connection, popkinId) per Popkin: group "popkin:{popkinId}"
  handler -> presence : Connect(connectionId, personId, popkinIds)
  presence -> hub : Changed; PresenceBroadcaster sends PresenceChanged(popkinId, version, hereNow) to each popkin group
  hub -> rt : PresenceChanged
  rt -> store : state connected; reconnected$ after every start
  store -> handler : Catch-up and GET /api/popkins/{popkinId}/presence
  store --> page : Header "14 members · 5 here now" (L2-021 AC1)
end
note over hub : SignalR answers the handshake before OnConnectedAsync has finished, so a started connection is not yet in its groups:\nthe client reads again after every start.\nDirect-message events go to Clients.Users(personA, personB) and need no group.\nA member who joins a Popkin is added to its group by JoinPopkinCommandHandler.
@enduml
