@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Messages arrive as they are sent

Container_Boundary(web, "Popkin web app") {
  Component(rt, "PopkinRealtime / SignalRPopkinRealtime", "api library service", "One HubConnection per tab, started by the first thread opened; automatic reconnect")
  Component(store, "ThreadStore", "api library service", "Applies events; keeps the view still; catch-up")
  Component(unread, "UnreadTracker", "api library service", "Unread counts per thread and per Popkin")
  Component(page, "GroupChatPage / DirectMessagePage", "Angular pages", "New messages control; polite live region")
}
Container_Boundary(api, "Popkin API") {
  Component(hub, "PopkinHub", "SignalR hub, [Authorize]", "A transport: sends ConnectToHubCommand, whose handler adds the connection to popkin:{popkinId} groups")
  Component(uid, "PersonUserIdProvider", "IUserIdProvider", "User id = PersonId claim")
  Component(presence, "PresenceTracker", "Application singleton", "People per Popkin for here now, with a version and a 20 s grace")
  Component(notifier, "SignalRPopkinNotifier", "IPopkinNotifier", "Routes events to groups or users")
  Component(read, "MarkThreadReadCommandHandler", "MediatR handler", "Moves ThreadReadState forward")
  ComponentDb(db, "Popkin database", "SQL Server", "Message, ThreadReadState")
}
Rel(rt, hub, "Connects", "WebSocket, cookie")
Rel(hub, uid, "Identifies users by")
Rel(hub, presence, "Connect and Disconnect, through MediatR")
Rel(notifier, hub, "Sends through IHubContext")
Rel(rt, store, "Streams events to")
Rel(rt, unread, "Streams events to")
Rel(page, store, "Reads")
Rel(store, read, "PUT read via ChatApi", "JSON/HTTPS")
Rel(read, db, "Writes", "EF Core")
@enduml
