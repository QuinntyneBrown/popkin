@startuml
title UML sequence behaviour — Send a message with a photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam maxMessageSize 260
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "pk-composer /\nThreadStore" as page
  participant "MessageOutbox" as outbox
  participant "ChatApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "ThreadsController /\nMessagesController" as controller
  participant "SignalRPopkinNotifier" as notifier
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "UploadChatPhotoCommandHandler" as handler
  participant "SendMessageCommandHandler" as send
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  participant "IPhotoStore" as photos
  database "Popkin database" as db
end box
actor -> page : Send (photo with or without text, perhaps a reply)
page -> outbox : enqueue(popkinId, threadId, text, replyTo?, photo)
page -> page : Clear the photo preview
outbox --> page : Pending row with the photo from its object URL, marked as sending
outbox -> client : uploadPhoto(popkinId, threadId, file)
client -> controller : POST /api/popkins/{popkinId}/threads/{threadId}/photos (multipart)
controller -> controller : Request limit 10 MB plus 64 KB; photos rate limit
controller -> handler : Send UploadChatPhotoCommand
handler -> handler : Membership, ChatThread.CanRead, Popkin not wrapped up (else 409 popkin_wrapped_up)
handler -> handler : ImageSniffer: content is JPEG, PNG, WebP or HEIC, at most 10 MB (L2-052 AC3)
alt type or size not allowed
  controller --> client : 400 photo_type_not_allowed or photo_too_large
  client --> outbox : Refused; the message is "Not sent"
else allowed
  handler -> handler : IPhotoProcessor removes location and device data; display and thumbnail (L2-031 AC6)
  handler -> photos : PutAsync(display and thumbnail)
  handler -> db : Insert Photo, ThreadId = threadId, InAlbum false
  controller --> client : 201 ChatPhotoDto { id, url, width, height }
  client --> outbox : photoId kept on the entry
  outbox -> client : send(…, clientMessageId, text, replyToMessageId?, photoId)
  client -> controller : POST …/threads/{threadId}/messages
  controller -> send : Send SendMessageCommand
  send -> send : Photo is the caller's, for this thread, on no message (else 400 photo_not_found)
  send -> db : Save Message with PhotoId
  alt Everyone (L2-026 AC3)
    send -> db : Photo.InAlbum = true, AddedAt = now: in Photos under the sender
    send -> notifier : MessageAdded and PhotoAdded to the Popkin's group
  else Direct message (L2-023 AC2)
    send -> notifier : MessageAdded to the two members alone; not in the album
  end
  controller --> client : 201 MessageDto with Photo, its url signed and expiring (L2-051 AC2)
  client --> outbox : Sent
  outbox --> page : Photo at most 16 rem wide at 4:3, text under it (L2-026 AC2)
end
alt upload or send fails (network or 5xx)
  outbox --> page : Not sent; Try again reuses photoId when the upload had succeeded
end
actor -> page : Choose "Open photo from {first name}"
page --> actor : Photo view /p/{popkinId}/photos/{photoId} (L2-026 AC2)
@enduml
