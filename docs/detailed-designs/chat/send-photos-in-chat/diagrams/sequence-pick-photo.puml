@startuml
title UML sequence behaviour — Pick a photo for a message
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam maxMessageSize 260
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "pk-composer" as composer
  participant "Device picker\n(input type=file)" as picker
  participant "ThreadStore\n(api library)" as store
end box
actor -> composer : Choose "Photo"
composer -> picker : click(); accept JPEG, PNG, WebP, HEIC; one file (no dialog)
actor -> picker : Pick from the device or take one with the camera
picker --> composer : change(File)
composer -> store : choosePhoto(file)
store -> store : albumPhotoProblem(file): type and size (L2-026 AC4, L2-031 AC2)
alt not an allowed type, or larger than 10 MB
  store --> composer : photoProblem = "This file is 14 MB. Photos can be up to 10 MB."
  composer --> actor : Alert above the field with "Dismiss"; nothing previewed (group-chat/photo-refused)
else allowed
  store -> store : photo = { file, object URL }; revoke the URL it replaces
  store --> composer : photo
  composer --> actor : Photo preview with "Remove photo"; Send enabled without text (L2-026 AC1, group-chat/photo-preview)
  opt Remove photo
    actor -> composer : Remove photo
    composer -> store : removePhoto(); revoke the object URL
    composer --> actor : Preview gone; focus back on "Photo"; Send follows the text again
  end
end
@enduml
