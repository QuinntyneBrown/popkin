@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members

title Class structure — Send photos in chat

package "Popkin.Domain" {
  class Photo {
    +Guid Id
    +Guid PopkinId
    +Guid UploaderMembershipId
    +DateTimeOffset TakenAt
    +DateTimeOffset AddedAt
    +string StorageKey
    +string ThumbnailKey
    +int Width
    +int Height
    +Guid? ThreadId
    +bool InAlbum
  }
  class Message {
    +Guid? PhotoId
    +string Text
  }
}
package "Popkin.Application" {
  class UploadThreadPhotoCommand {
    +Guid PopkinId
    +Guid ThreadId
    +Stream Content
    +long Length
  }
  class UploadThreadPhotoCommandHandler
  class SendMessageCommandHandler {
    +photoId must be the caller's, this thread's, unused
    +Everyone: Photo.InAlbum = true, PhotosAdded
  }
  class ChatPhotoDto {
    +Guid Id
    +string Url
    +int Width
    +int Height
  }
  class MessageDto {
    +ChatPhotoDto? Photo
  }
  interface IPhotoStore {
    +PutAsync(key, stream, contentType)
  }
  interface IPhotoProcessor {
    +ProcessAsync(stream): display and thumbnail, metadata removed
  }
  class PhotoUrlSigner {
    +Sign(key): expiring address
  }
}
package "web app (api, components)" {
  class ThreadStore {
    +photo: Signal<{ file, previewUrl } | null>
    +photoProblem: Signal<string | null>
    +choosePhoto(file): void
    +removePhoto(): void
    +dismissPhotoProblem(): void
    +send(text): void
  }
  class MessageOutbox {
    +enqueue(popkinId, threadId, text, replyTo?, photo?: File): void
  }
  class ChatApi {
    +uploadPhoto(popkinId, threadId, file): Observable<ChatPhotoView>
    +send(..., replyToMessageId?, photoId?)
  }
  class MessageRow {
    +photo: { id, url, alt, label, link }
  }
}
UploadThreadPhotoCommandHandler ..> UploadThreadPhotoCommand : handles
UploadThreadPhotoCommandHandler ..> IPhotoProcessor
UploadThreadPhotoCommandHandler ..> IPhotoStore
UploadThreadPhotoCommandHandler --> Photo : creates, InAlbum false
UploadThreadPhotoCommandHandler ..> ChatPhotoDto : returns
SendMessageCommandHandler --> Message : saves
SendMessageCommandHandler --> Photo : puts Everyone's in the album
MessageDto --> ChatPhotoDto
ChatPhotoDto ..> PhotoUrlSigner : url signed by
Message "0..1" --> "0..1" Photo
ThreadStore ..> MessageOutbox : send
MessageOutbox ..> ChatApi : upload, then send
ThreadStore ..> MessageRow : derives
@enduml
