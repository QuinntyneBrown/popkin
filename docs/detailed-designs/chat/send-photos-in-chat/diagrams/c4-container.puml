@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send photos in chat

Person(member, "Member", "Signed-in person who belongs to a Popkin")
System_Ext(camera, "Device camera", "Browser file input with capture")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "Add photos dialog in chat mode; composer photo preview")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "Thread photo upload and messages endpoints")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Photo and Message rows")
  ContainerDb(store, "Photo store", "Object storage (provider TO SUPPLY)", "Photo files, metadata removed")
}
Rel(member, spa, "Uses", "HTTPS")
Rel(spa, camera, "Picks or takes one photo")
Rel(spa, api, "Uploads the photo, then posts the message", "multipart and JSON/HTTPS")
Rel(api, store, "Writes files; issues expiring read addresses", "HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
