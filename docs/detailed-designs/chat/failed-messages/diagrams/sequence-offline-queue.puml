@startuml
title UML sequence behaviour — Send while offline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam maxMessageSize 260
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "GroupChatPage" as page
  participant "MessageOutbox" as outbox
  participant "NetworkStatus" as net
  participant "ChatApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "MessagesController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "SendMessageCommandHandler" as handler
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
net -> page : offline event (navigator.onLine false or hub disconnected)
page --> actor : Danger banner "You're offline. Messages will send when you're back." stays until online (L2-028 AC3)
actor -> page : Send two messages
page -> outbox : enqueue(c2), enqueue(c3)
outbox -> outbox : OutboxStorage.put each entry (IndexedDB, survives reload)
outbox --> page : Both marked "Waiting to send" in order (L2-028 AC2)
net -> outbox : backOnline$
loop each Waiting entry of the thread, oldest first
  outbox -> client : sendMessage(..., cN)
  client -> controller : POST .../messages
  controller -> handler : SendMessageCommand
  handler -> db : Insert (or return existing)
  controller --> client : 201 or 200 MessageDto
  client --> outbox : Sent; OutboxStorage.remove(cN)
end
alt a send fails again
  outbox --> page : Entry becomes "Not sent"; the queue continues for rejected, pauses for network
end
page --> actor : Success banner "Back online. 2 messages sent."
@enduml
