@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Who sees a day

Person(person, "Person", "Adder, member or outsider")
Person(admin, "Admin", "Admin app")
System_Boundary(popkin, "Popkin") {
  Container(web, "Popkin web app", "Angular", "Important days, the strip, a Popkin's Days, a day's details")
  Container(adminApp, "Popkin admin app", "Angular", "No screen reads an own day")
  Container(api, "Popkin API", "ASP.NET Core", "/api/days/**, /api/popkins/{popkinId}/days/**; PopkinHub")
  Container(worker, "Popkin Worker", ".NET worker", "SendImportantDayRemindersJob: adder or members only")
  ContainerDb(db, "Popkin database", "SQL Server", "ImportantDay, ImportantDayPerson, Membership, Contact")
}
Rel(person, web, "Uses", "HTTPS")
Rel(admin, adminApp, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(adminApp, api, "Calls /api/admin/**, which reads no own day", "JSON/HTTPS")
Rel(api, db, "Reads readable days only; writes", "EF Core")
Rel(worker, db, "Reads days and their recipients", "EF Core")
@enduml
