@startuml
title UML sequence behaviour — A Popkin's day read by members only
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Priya (member of Tigers U9 Parents)" as member
actor "Lena (not a member)" as outsider
box "Frontend — Popkin web app" #E0F2FE
  participant "ImportantDaysPage" as page
  participant "HttpDaysApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "DaysController" as ctrl
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "GetImportantDaysQueryHandler" as handler
  participant "DayVisibility" as visibility
  participant "IMembershipGuard" as guard
  participant "DayPeople" as people
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
member -> page : Open Important days
page -> client : list(on, everything)
client -> ctrl : GET /api/days?on=2025-12-01&show=everything
ctrl -> handler : Send GetImportantDaysQuery
handler -> visibility : ReadableAsync(Priya)
visibility -> db : Memberships with LeftAt null, Schedules on; their days
db --> visibility : "Last game and trophy party", added by Mara
handler -> people : ShownTo(day, [Leo], Priya)
people --> handler : [] (gap 141, proposed)
handler --> ctrl : The day with Tigers U9 Parents' emoji and name, no people (L2-195 AC2)
ctrl --> client : 200
client --> page : Row without faces or names
page --> member : "Last game and trophy party", "Tigers U9 Parents"
outsider -> page : Choose a Popkin's address or show
page -> client : list(on, Tigers U9 Parents)
client -> ctrl : GET /api/days?on=2025-12-01&show={popkinId}
ctrl -> handler : Send GetImportantDaysQuery(Popkin)
handler -> guard : RequireMemberAsync(popkinId)
guard --> handler : 404 popkin_not_found (L2-051)
handler --> ctrl : ProblemDetails
ctrl --> client : 404 popkin_not_found
client --> page : failed
page --> outsider : Nothing of the Popkin's days (L2-195 AC2)
@enduml
