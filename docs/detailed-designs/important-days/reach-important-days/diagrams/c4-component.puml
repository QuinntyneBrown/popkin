@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Reach Important days

Container_Boundary(web, "Popkin web app") {
  Component(page, "MyPopkinsPage", "Angular page", "Days button, pk-coming-days above pk-popkin-grid")
  Component(store, "ComingDaysStore", "api library", "Up to three ComingDay tiles; empty on failure")
  Component(client, "DAYS_API", "api library contract", "HttpDaysApi.coming(on)")
  Component(days, "ImportantDaysPage", "Angular page", "/days; Your Popkins back to /")
}
Container_Boundary(api, "Popkin API") {
  Component(ctrl, "DaysController", "ASP.NET Core controller", "GET /api/days/coming?on=")
  Component(handler, "GetComingDaysQueryHandler", "MediatR handler", "Coming days, no holidays, none inside another")
  Component(visibility, "DayVisibility", "Application service", "Own days and days of the caller's Popkins with Schedules on")
  Component(rules, "ImportantDayRules", "Domain rules", "Occurrence(day, today)")
  ComponentDb(db, "Popkin database", "SQL Server", "ImportantDay, PopkinSpace, Membership")
}
Rel(page, store, "open(device day)")
Rel(store, client, "coming(on)")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(page, days, "Days button, strip and All important days open", "routerLink /days")
Rel(ctrl, handler, "Sends GetComingDaysQuery(on)")
Rel(handler, visibility, "ReadableAsync(personId)")
Rel(handler, rules, "Occurrence per day")
Rel(visibility, db, "Reads", "EF Core")
@enduml
