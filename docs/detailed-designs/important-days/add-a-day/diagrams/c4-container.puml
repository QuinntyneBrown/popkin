@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Containers — Add a day

Person(person, "Person", "Adder of the day")
Person(member, "Member", "Has the Popkin's Days open")
System_Boundary(popkin, "Popkin") {
  Container(web, "Popkin web app", "Angular", "AddDayPage at /days/new; Important days; a Popkin's Days")
  Container(api, "Popkin API", "ASP.NET Core", "/api/days, /api/popkins/{id}/days; PopkinHub")
  ContainerDb(db, "Popkin database", "SQL Server", "ImportantDay, ImportantDayPerson, Contact, Membership")
}
Rel(person, web, "Uses", "HTTPS")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, web, "ScheduleChanged for a Popkin's day", "SignalR")
@enduml
