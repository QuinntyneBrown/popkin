@startuml
title UML sequence behaviour — Send a day's reminder
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "TimeProvider" as time
box "Backend — Popkin Worker" #D1FADF
  participant "DispatchNotificationsJob" as djob
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "DispatchNotificationsCommandHandler" as dispatch
  participant "NotificationRules" as nrules
  participant "ImportantDayReminderStanding" as standing
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
  participant "WebPushPhoneNotificationSender" as phone
end box
time -> djob : 15 s elapse
djob -> dispatch : Send DispatchNotificationsCommand
dispatch -> db : New events; the recipient's settings, level, holds, platform controls
db --> dispatch : ImportantDays event for one recipient
dispatch -> nrules : Decide(phone): pause, kind off, held, switch; level Muted or "Just for me" keeps it
nrules --> dispatch : Send(now): no bundle, no quiet hours, no daily most
dispatch -> db : NotificationDelivery (event, person, Phone) Due; unique key
dispatch -> standing : StandingAsync(event, person)
standing -> db : The day now
db --> standing : Day, or none
alt Deleted, reminder None, date changed, moved off the Popkin
  standing --> dispatch : Nothing
  dispatch -> db : Suppressed NothingNew (L2-193 AC2, L2-174 AC1)
else Stands
  standing --> dispatch : PhoneAlert(title <TO SUPPLY>, body, /days or /p/{id}/schedule/days?day={day})
  dispatch -> phone : SendAsync(person, PhoneAlert)
  phone --> dispatch : Devices that took it; gone subscriptions removed
  dispatch -> db : Sent
end
@enduml
