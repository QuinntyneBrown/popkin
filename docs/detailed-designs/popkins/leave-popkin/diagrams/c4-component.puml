@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Leave a Popkin

Container_Boundary(spa, "Popkin web app") {
  Component(dlg, "LeavePopkinDialog", "CDK dialog", "Leave or Stay")
  Component(mapi, "PopkinsApi", "Contract + HTTP client", "leave(id)")
  Component(toaster, "Toaster", "App service", "Failure toast")
}
Container_Boundary(api, "Popkin API") {
  Component(ctrl, "MembersController", "Controller", "DELETE /api/popkins/(id)/members/me")
  Component(handler, "LeavePopkinCommandHandler", "MediatR handler", "Refuses the Host; sets LeftAt")
  Component(guard, "IMembershipGuard", "Abstraction", "Active membership only")
  Component(notifier, "IPopkinNotifier", "Abstraction", "MemberLeft, removes connections from group")
  ComponentDb(db, "AppDbContext", "EF Core", "Popkin database")
}
Rel(dlg, mapi, "leave()")
Rel(dlg, toaster, "Shows failure")
Rel(mapi, ctrl, "HTTPS")
Rel(ctrl, handler, "LeavePopkinCommand")
Rel(handler, guard, "Requires membership")
Rel(handler, db, "Saves")
Rel(handler, notifier, "Publishes MemberLeft")
@enduml
