@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Popkin home

Person(member, "Member", "Belongs to the Popkin")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "popkin-home page and pk-popkin-nav tabs")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "Home header and four section endpoints; PopkinHub at /hubs/popkin")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "PopkinSpace, Membership, Message, Photo, Experience")
  Container(store, "Photo store", "Object storage, provider TO SUPPLY", "Thumbnails and avatars")
}
Rel(member, spa, "Uses", "HTTPS")
Rel(spa, api, "Loads header and sections", "JSON/HTTPS")
Rel(api, spa, "Pushes PopkinChanged, MemberJoined, MemberLeft, MessageAdded", "SignalR WebSocket")
Rel(api, db, "Reads", "EF Core")
Rel(spa, store, "Loads thumbnails", "expiring signed URLs")
@enduml
