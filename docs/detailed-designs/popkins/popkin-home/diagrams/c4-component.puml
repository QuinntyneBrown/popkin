@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Popkin home

Container_Boundary(spa, "Popkin web app") {
  Component(page, "PopkinHomePage", "Angular page", "Header, actions, Chat, Photos, Experiences, Members")
  Component(papi, "PopkinsApi", "Contract + HTTP client", "getHome, getMembers")
  Component(capi, "ChatApi / PhotosApi / ExperiencesApi", "Contracts + HTTP clients", "Section summaries")
  Component(rt, "PopkinRealtime", "SignalR client", "popkin:(id) group events")
}
Container_Boundary(api, "Popkin API") {
  Component(pctrl, "PopkinsController / MembersController", "Controllers", "GET /api/popkins/(id), /members")
  Component(sctrl, "ThreadsController / PhotosController / ExperiencesController", "Controllers", "Section summaries")
  Component(hub, "PopkinHub", "SignalR hub", "/hubs/popkin")
  Component(handlers, "GetPopkinHomeQueryHandler and section query handlers", "MediatR handlers", "One query per section")
  Component(guard, "IMembershipGuard", "Abstraction", "404 popkin_not_found for non-members")
  ComponentDb(db, "AppDbContext", "EF Core", "Popkin database")
}
Rel(page, papi, "Loads header and members")
Rel(page, capi, "Loads sections independently")
Rel(page, rt, "Subscribes")
Rel(papi, pctrl, "HTTPS")
Rel(capi, sctrl, "HTTPS")
Rel(rt, hub, "WebSocket")
Rel(pctrl, handlers, "Sends queries")
Rel(sctrl, handlers, "Sends queries")
Rel(handlers, guard, "Checks membership")
Rel(handlers, db, "Reads", "EF Core")
@enduml
