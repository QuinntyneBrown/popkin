@startuml
title UML sequence behaviour — Move on from My Popkins
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "MyPopkinsPage" as page
  participant "Router" as router
  participant "CDK Dialog" as dialog
end box
alt choose an active card (L2-017 AC3)
  actor -> page : Choose "Lakeside Weekend"
  page -> router : navigate /p/(id)
else choose a wrapped-up Popkin (L2-018 AC2)
  actor -> page : Choose "Build Weekend '26"
  page -> router : navigate /p/(id)/recap
else choose "New Popkin" (L2-017 AC4)
  actor -> page : Choose "New Popkin"
  page -> router : navigate /new
else choose own avatar (L2-017 AC5)
  actor -> page : Choose avatar in pk-top-bar
  page -> router : navigate /account
else choose "Scan to join" (empty state, L2-015 AC1)
  actor -> page : Choose "Scan to join"
  page -> dialog : open(ScanToJoinDialog)
end
router --> actor : Next screen frame within 100 ms (L2-055 AC2)
@enduml
