@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Popkin settings

Person(host, "Host", "Started the Popkin")
Person(member, "Member", "Belongs to the Popkin")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "popkin-settings, edit-popkin, change-length, end-date dialogs")
  Container(api, "Popkin API", "ASP.NET Core, .NET 10", "PATCH /api/popkins/(id), PUT /api/popkins/(id)/length, PopkinHub")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "PopkinSpace")
}
Rel(host, spa, "Uses", "HTTPS")
Rel(member, spa, "Uses", "HTTPS")
Rel(spa, api, "Saves changes", "JSON/HTTPS")
Rel(api, db, "Updates", "EF Core")
Rel(api, spa, "Pushes PopkinChanged to every member", "SignalR")
@enduml
