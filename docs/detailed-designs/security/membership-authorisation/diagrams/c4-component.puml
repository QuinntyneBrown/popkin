@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Membership authorisation

Container(spa, "Popkin web app", "Angular", "memberGuard")
Container_Boundary(api, "Popkin API") {
  Component(auth, "Authentication and fallback policy", "ASP.NET Core middleware", "401 without a session")
  Component(ctrls, "Popkin-scoped controllers", "PopkinsController, PhotosController, MessagesController, ...", "Send MediatR requests")
  Component(hub, "PopkinHub", "SignalR hub", "A transport: sends ConnectToHubCommand; no client method joins a group")
  Component(handlers, "Handlers", "MediatR handlers", "Call the guard first")
  Component(guard, "MembershipGuard", "IMembershipGuard", "RequireMemberAsync, RequireActiveMemberAsync, RequireHostAsync")
  Component(current, "HttpCurrentPerson", "ICurrentPerson", "PersonId from claims")
  Component(errors, "ProblemDetailsExceptionHandler", "IExceptionHandler", "404 popkin_not_found, 403 host_only")
  ComponentDb(db, "Popkin database", "SQL Server", "Membership, PopkinSpace")
}
Rel(spa, auth, "Request", "JSON/HTTPS")
Rel(auth, ctrls, "Authenticated request")
Rel(ctrls, handlers, "Send")
Rel(hub, handlers, "Send; the handler adds the connection to the groups of the person's memberships")
Rel(handlers, guard, "Require...Async(popkinId)")
Rel(guard, current, "PersonId")
Rel(guard, db, "One query: membership with Popkin", "EF Core")
Rel(guard, errors, "Throws guard exceptions")
Rel(errors, spa, "ProblemDetails with code", "JSON/HTTPS")
@enduml
