@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Personal data protection

Container(spa, "Popkin web app", "Angular", "MemberView without contact data")
Container_Boundary(api, "Popkin API") {
  Component(headers, "SecurityHeadersMiddleware", "ASP.NET Core middleware", "CSP, nosniff, frame policy, referrer, permissions")
  Component(https, "HttpsRedirection and HSTS", "ASP.NET Core middleware", "308 to HTTPS, Strict-Transport-Security")
  Component(reqlog, "RequestLoggingMiddleware", "ASP.NET Core middleware", "Route template, status, duration")
  Component(handler, "GetMembersQueryHandler", "MediatR handler", "Projects to MemberDto")
  Component(redact, "Redaction", "Microsoft.Extensions.Compliance", "Erase secrets, hash personal data")
  ComponentDb(db, "Popkin database", "SQL Server, TDE", "Membership, Person")
}
Rel(spa, headers, "Request", "HTTPS")
Rel(headers, https, "Next")
Rel(https, reqlog, "Next")
Rel(reqlog, handler, "Through controller")
Rel(handler, db, "Membership projection only", "EF Core")
Rel(reqlog, redact, "Log event")
Rel(headers, spa, "Response with security headers", "HTTPS")
@enduml
