@startuml
title UML sequence behaviour — A member lists the members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "PopkinHomePage" as page
  participant "PopkinsApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "RequestLoggingMiddleware" as reqlog
  participant "MembersController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "GetMembersQueryHandler" as handler
  participant "IMembershipGuard" as guard
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
  participant "Redactor and log sink" as logs
end box
actor -> page : Open Popkin home
page -> client : getMembers(popkinId)
client -> reqlog : GET /api/popkins/{popkinId}/members
reqlog -> controller : Next
controller -> handler : Send GetMembersQuery
handler -> guard : RequireMemberAsync(popkinId)
guard --> handler : MemberAccess
handler -> db : Select MembershipId, DisplayName, PhotoId, Role from Membership
db --> handler : Rows (no Person.Phone or Person.Email read)
handler --> controller : MemberDto list
controller --> reqlog : 200 OK
reqlog -> logs : GET /api/popkins/{popkinId}/members 200 12 ms, person = keyed hash (L2-054 AC3)
reqlog --> client : 200 OK
page --> actor : Names and photos only, Host first (L2-054 AC2)
@enduml
