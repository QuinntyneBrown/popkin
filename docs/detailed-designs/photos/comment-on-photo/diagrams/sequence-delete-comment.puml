@startuml
title UML sequence behaviour — Delete own comment
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "PhotoCommentsDialog" as dialog
  participant "Confirm dialog\n(mock TO SUPPLY)" as confirm
  participant "PhotosApi" as client
end box
box "Backend — Popkin API" #D1FADF
  participant "PhotosController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "DeletePhotoCommentCommandHandler" as handler
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box

actor -> dialog : Choose "Delete" on own comment (offered only when mine)
dialog -> confirm : Ask to confirm
alt Cancel
  confirm --> dialog : No
  dialog --> actor : Comment stays
else Confirm
  confirm --> dialog : Yes
  dialog -> client : deleteComment(popkinId, photoId, commentId)
  client -> controller : DELETE /api/popkins/{popkinId}/photos/{photoId}/comments/{commentId}
  controller -> handler : Send DeletePhotoCommentCommand
  handler -> db : Check membership; load comment of this photo
  alt Not found
    controller --> client : 404 comment_not_found
  else Another member's comment
    controller --> client : 403 comment_not_yours
  else Own comment
    handler -> db : Delete, save
    controller --> client : 204 No Content
  end
  alt Failure
    dialog --> actor : Comment stays, message TO SUPPLY
  else Deleted
    dialog --> actor : Comment removed, count - 1 (L2-035 AC5)
  end
end
@enduml
