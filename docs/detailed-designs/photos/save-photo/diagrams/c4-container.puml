@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Save a photo

Person(member, "Member", "Belongs to the Popkin")
System_Boundary(popkin, "Popkin") {
  Container(spa, "Popkin web app", "Angular 20+ SPA", "Photos pages and dialogs")
  Container(api, "Popkin API", "ASP.NET Core (.NET 10)", "PhotosController and PopkinHub")
  ContainerDb(db, "Popkin database", "SQL Server via EF Core", "Photos, reactions, comments, memberships")
  ContainerDb(store, "Photo store", "Object storage, provider TO SUPPLY (known gap 9)", "Photo files, encrypted at rest")
}
Rel(member, spa, "Uses", "HTTPS")
Rel(spa, api, "Requests a download address; deletes a photo", "JSON/HTTPS")
Rel(api, db, "Deletes Photo, reactions, comments; marks messages", "EF Core")
Rel(api, store, "Signs the stored image's address as an attachment; removes files", "IPhotoStore")
Rel(spa, store, "Loads image files by expiring address", "HTTPS")
Rel(api, spa, "Pushes PhotoDeleted to the photo's audience", "SignalR/WebSocket")
@enduml
