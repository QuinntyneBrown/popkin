@startuml
title UML sequence behaviour — Save a photo to the device
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "PhotoViewPage" as page
  participant "PhotosApi" as client
  participant "Browser download" as browser
end box
box "Backend — Popkin API" #D1FADF
  participant "PhotosController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "GetPhotoDownloadQueryHandler" as handler
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
  participant "IPhotoStore" as store
end box
participant "Photo store" as files

actor -> page : Choose "Save photo"
page --> actor : "Save photo" busy and disabled (L2-056 AC3)
page -> client : getDownload(popkinId, photoId)
client -> controller : GET /api/popkins/{popkinId}/photos/{photoId}/download
controller -> handler : Send GetPhotoDownloadQuery
handler -> db : Check membership; load Photo in this Popkin
alt Not a member or no such photo
  controller --> client : 404 popkin_not_found or photo_not_found (L2-051 AC1)
  client --> page : Error
  page --> actor : "We couldn’t save this photo." / "Try again in a moment." (L2-056 AC7)
else Found
  handler -> store : GetDownloadUrl(StorageKey, "popkin-photo-{yyyyMMdd-HHmm}.jpg"), one hour
  store --> handler : Signed address with attachment disposition (L2-051 AC2)
  controller --> client : 200 OK {url, expiresAt}
  client --> page : Download address
  page -> browser : Activate a temporary link to the address
  browser -> files : GET the stored image
  files --> browser : The stored image, longest edge at most 2048 px (L2-036 AC1)
  browser --> actor : Saved to the device
end
@enduml
