@startuml
title UML sequence behaviour — Saving my hours
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "ThisWeekPage" as page
  participant "ThisWeekStore" as store
  participant "HttpScheduleApi" as client
  participant "MyHoursDialog" as dialog
end box
box "Backend — Popkin API" #D1FADF
  participant "ScheduleController" as controller
end box
box "Backend — Popkin Application and Domain" #ECFDF3
  participant "IFeatureSwitches" as switches
  participant "IMembershipGuard" as guard
  participant "Handler" as handler
  participant "WorkingHours" as rules
  participant "IPopkinNotifier" as notifier
end box
box "Backend — Popkin Infrastructure" #FFF4E5
  database "Popkin database" as db
end box
actor -> page : Choose "My hours"
page -> dialog : Open with my stretches of the seven days
actor -> dialog : Enter a start and an end per day, "Add another" for a second
alt A day ends before it starts
  dialog --> actor : "Thursday ends before it starts.", "Save" disabled (L2-074 AC8)
end
actor -> dialog : "Save"
dialog -> dialog : "Saving…", disabled (L2-073 AC2)
dialog -> client : setHours(popkinId, myMembershipId, from, days)
client -> controller : PUT /api/popkins/{popkinId}/schedule/hours/{membershipId}
controller -> handler : Send SetWorkingHoursCommand
handler -> switches : Require(Schedules)
handler -> guard : RequireActiveMemberAsync(popkinId)
alt Another member's id
  controller --> client : 403 not_your_schedule
else Allowed
  handler -> rules : Check each day
  alt Not on the quarter hour, end not after start, more than two, overlap
    controller --> client : 400 invalid_hours
  else Valid
    handler -> db : Replace the seven days
    handler -> notifier : ScheduleChanged(popkinId)
    controller --> client : 200 ThisWeekDto
    dialog --> page : Close; the week shows my hours
  end
end
alt Failure
  dialog --> actor : Stays open with the hours; "We couldn't save that." (L2-073 AC3)
end
@enduml
