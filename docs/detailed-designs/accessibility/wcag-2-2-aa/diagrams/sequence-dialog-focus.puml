@startuml
title UML sequence behaviour — A dialog takes and returns focus
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member (keyboard)" as actor
box "Frontend — Popkin web app" #E0F2FE
  participant "PopkinHomePage" as page
  participant "DialogOpener" as opener
  participant "CDK Dialog and FocusTrap" as cdk
  participant "InviteDialog" as dialog
end box

actor -> page : Enter on "Invite"
page -> opener : open(InviteDialog, data, labelledBy)
opener -> cdk : open with autoFocus first-tabbable, restoreFocus true, ariaLabelledBy
cdk -> cdk : Remember focused element ("Invite"); page behind inert
cdk -> dialog : Render inside pk-dialog
cdk -> dialog : Focus cdkFocusInitial or first tabbable
dialog --> actor : "Bring someone in" read as dialog name (L2-057 AC2)
actor -> dialog : Tab past the last control
cdk -> dialog : Wrap focus to the first control
actor -> dialog : Escape
dialog -> cdk : close()
cdk -> page : Restore focus to "Invite" (L2-011 AC3)
page --> actor : Focus ring on "Invite"
@enduml
