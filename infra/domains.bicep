// popkin.community on Azure (ADR 0020):
// - an Azure DNS zone holds every record of the domain; the registrar (Namecheap) only names
//   its four name servers;
// - Azure Front Door Standard ends TLS with certificates it issues and renews itself, a wildcard
//   among them, and routes by host:
//     app.popkin.community and *.popkin.community -> popkin-web (the app, which reads its host
//       to tell the app from a Popkin's address, as Open a Popkin by its address describes);
//     popkin.community and www.popkin.community  -> the marketing site's Static Web App.
// A name with a record of its own (app, www, the _dnsauth checks) wins over the wildcard.
@description('The registered domain.')
param domain string = 'popkin.community'

@description('The host name of the popkin-web container app.')
param webHostName string

@description('The default host name of the marketing site\'s Static Web App.')
param marketingHostName string

resource zone 'Microsoft.Network/dnsZones@2018-05-01' = {
  name: domain
  location: 'global'
}

resource profile 'Microsoft.Cdn/profiles@2024-02-01' = {
  name: 'afd-popkin'
  location: 'global'
  sku: { name: 'Standard_AzureFrontDoor' }
  properties: {
    // The hub's WebSockets stay open; Front Door closes one after 5 idle minutes, and SignalR
    // pings every 15 seconds.
    originResponseTimeoutSeconds: 60
  }
}

resource endpoint 'Microsoft.Cdn/profiles/afdEndpoints@2024-02-01' = {
  parent: profile
  name: 'popkin'
  location: 'global'
  properties: {
    enabledState: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
  }
}

// The four custom domains, each with a certificate Front Door manages and renews. Their
// ownership is proven by a TXT record at _dnsauth.<name>, written below in the same zone.
var domains = [
  { key: 'apex', hostName: domain, label: '@' }
  { key: 'www', hostName: 'www.${domain}', label: 'www' }
  { key: 'app', hostName: 'app.${domain}', label: 'app' }
  { key: 'wildcard', hostName: '*.${domain}', label: '*' }
]

resource customDomains 'Microsoft.Cdn/profiles/customDomains@2024-02-01' = [
  for d in domains: {
    parent: profile
    name: '${d.key}-${replace(domain, '.', '-')}'
    properties: {
      hostName: d.hostName
      azureDnsZone: { id: zone.id }
      tlsSettings: {
        certificateType: 'ManagedCertificate'
        minimumTlsVersion: 'TLS12'
      }
    }
  }
]

// The apex and the wildcard are both checked at _dnsauth.<domain>: one record set, two values.
resource dnsauthApex 'Microsoft.Network/dnsZones/TXT@2018-05-01' = {
  parent: zone
  name: '_dnsauth'
  properties: {
    TTL: 3600
    TXTRecords: [
      { value: [customDomains[0].properties.validationProperties.validationToken] }
      { value: [customDomains[3].properties.validationProperties.validationToken] }
    ]
  }
}

resource dnsauthWww 'Microsoft.Network/dnsZones/TXT@2018-05-01' = {
  parent: zone
  name: '_dnsauth.www'
  properties: {
    TTL: 3600
    TXTRecords: [{ value: [customDomains[1].properties.validationProperties.validationToken] }]
  }
}

resource dnsauthApp 'Microsoft.Network/dnsZones/TXT@2018-05-01' = {
  parent: zone
  name: '_dnsauth.app'
  properties: {
    TTL: 3600
    TXTRecords: [{ value: [customDomains[2].properties.validationProperties.validationToken] }]
  }
}

// The apex cannot be a CNAME; an alias A record follows the endpoint instead.
resource apexAlias 'Microsoft.Network/dnsZones/A@2018-05-01' = {
  parent: zone
  name: '@'
  properties: {
    TTL: 3600
    targetResource: { id: endpoint.id }
  }
}

resource cnames 'Microsoft.Network/dnsZones/CNAME@2018-05-01' = [
  for label in ['www', 'app', '*']: {
    parent: zone
    name: label
    properties: {
      TTL: 3600
      CNAMERecord: { cname: endpoint.properties.hostName }
    }
  }
]

resource webGroup 'Microsoft.Cdn/profiles/originGroups@2024-02-01' = {
  parent: profile
  name: 'web'
  properties: {
    loadBalancingSettings: { sampleSize: 4, successfulSamplesRequired: 3, additionalLatencyInMilliseconds: 50 }
    healthProbeSettings: {
      probePath: '/api/health'
      probeRequestType: 'GET'
      probeProtocol: 'Https'
      probeIntervalInSeconds: 100
    }
    sessionAffinityState: 'Disabled'
  }
}

// The Container Apps ingress routes by host, so the origin is asked for by its own name.
resource webOrigin 'Microsoft.Cdn/profiles/originGroups/origins@2024-02-01' = {
  parent: webGroup
  name: 'popkin-web'
  properties: {
    hostName: webHostName
    originHostHeader: webHostName
    httpPort: 80
    httpsPort: 443
    priority: 1
    weight: 1000
    enabledState: 'Enabled'
    enforceCertificateNameCheck: true
  }
}

resource marketingGroup 'Microsoft.Cdn/profiles/originGroups@2024-02-01' = {
  parent: profile
  name: 'marketing'
  properties: {
    loadBalancingSettings: { sampleSize: 4, successfulSamplesRequired: 3, additionalLatencyInMilliseconds: 50 }
    healthProbeSettings: {
      probePath: '/'
      probeRequestType: 'HEAD'
      probeProtocol: 'Https'
      probeIntervalInSeconds: 100
    }
    sessionAffinityState: 'Disabled'
  }
}

resource marketingOrigin 'Microsoft.Cdn/profiles/originGroups/origins@2024-02-01' = {
  parent: marketingGroup
  name: 'swa-popkin-marketing'
  properties: {
    hostName: marketingHostName
    originHostHeader: marketingHostName
    httpPort: 80
    httpsPort: 443
    priority: 1
    weight: 1000
    enabledState: 'Enabled'
    enforceCertificateNameCheck: true
  }
}

// No caching on the app's route: the proxy already sets Cache-Control, and a cached route would
// refuse the hub's WebSocket upgrade.
resource appRoute 'Microsoft.Cdn/profiles/afdEndpoints/routes@2024-02-01' = {
  parent: endpoint
  name: 'app'
  dependsOn: [webOrigin]
  properties: {
    originGroup: { id: webGroup.id }
    customDomains: [{ id: customDomains[2].id }, { id: customDomains[3].id }]
    supportedProtocols: ['Http', 'Https']
    patternsToMatch: ['/*']
    forwardingProtocol: 'HttpsOnly'
    httpsRedirect: 'Enabled'
    linkToDefaultDomain: 'Enabled'
    enabledState: 'Enabled'
  }
}

resource marketingRoute 'Microsoft.Cdn/profiles/afdEndpoints/routes@2024-02-01' = {
  parent: endpoint
  name: 'marketing'
  dependsOn: [marketingOrigin, appRoute]
  properties: {
    originGroup: { id: marketingGroup.id }
    customDomains: [{ id: customDomains[0].id }, { id: customDomains[1].id }]
    supportedProtocols: ['Http', 'Https']
    patternsToMatch: ['/*']
    forwardingProtocol: 'HttpsOnly'
    httpsRedirect: 'Enabled'
    linkToDefaultDomain: 'Disabled'
    enabledState: 'Enabled'
  }
}

output appOrigin string = 'https://app.${domain}'
output marketingOrigin string = 'https://${domain}'
output nameServers array = zone.properties.nameServers
output endpointHostName string = endpoint.properties.hostName
