@* The wrap-up reminder (L2-167 AC2, AC4): when the Popkin ends, the newest photos of its album, how
   many there are and how many are the person's, and "Add your photos". *@
<EmailShell Shell="Model.Shell">
<h1 class="email__headline" style="margin:0 0 8px;font-size:22px;line-height:1.3;color:@EmailStyles.Ink;">@Model.Headline</h1>
<p class="email__sub" style="margin:0 0 16px;font-size:15px;line-height:1.5;color:@EmailStyles.InkSoft;">@Model.Body</p>
@if (Model.Photos.Count > 0)
{
<table role="presentation" class="email-photos" width="100%" cellpadding="0" cellspacing="4">
<tr>
@foreach (var photo in Model.Photos)
{
<td width="25%"><img src="cid:@photo.ContentId" alt="@photo.Alt" width="132" style="display:block;width:100%;height:auto;border-radius:8px;"></td>
}
</tr>
</table>
}
@if (Model.SoFar is { } soFar)
{
<p class="email__line" style="margin:12px 0 0;font-size:15px;color:@EmailStyles.Ink;"><strong>@(soFar.Split(" so far")[0])</strong>@(" so far" + soFar.Split(" so far")[1]) @Model.Yours</p>
}
<EmailButton Link="Model.Button" />
</EmailShell>

@code {
    [Parameter, EditorRequired]
    public WrapUpEmailModel Model { get; set; } = default!;
}
