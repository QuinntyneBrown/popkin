@* The key date reminder (L2-166): the contact's photo or initials with their age, the day, what the
   owner keeps about them, and their page. No Popkin tile: it comes from Contacts. *@
<EmailShell Shell="Model.Shell">
<div class="email-hero" style="text-align:center;margin-bottom:16px;">
<div class="email-hero__face" style="display:inline-block;position:relative;margin-bottom:12px;">
@if (Model.Photo is { } photo)
{
<img src="cid:@photo.ContentId" alt="@photo.Alt" width="88" height="88" style="display:block;width:88px;height:88px;border-radius:999px;">
}
else
{
<span class="avatar" aria-hidden="true" style="display:inline-block;width:88px;height:88px;line-height:88px;border-radius:999px;background:@EmailStyles.Accent;font-size:28px;font-weight:700;color:@EmailStyles.Ink;">@Model.Initials</span>
}
@if (Model.Age is { } age)
{
<span class="email-hero__age" aria-hidden="true" style="position:absolute;right:-6px;bottom:-4px;display:inline-block;min-width:32px;height:32px;line-height:32px;border-radius:999px;background:@EmailStyles.Surface;border:2px solid @EmailStyles.Accent;font-weight:700;font-size:14px;color:@EmailStyles.Ink;">@age</span>
}
</div>
<h1 class="email__headline" style="margin:0 0 6px;font-size:22px;line-height:1.3;color:@EmailStyles.Ink;">@Model.Headline</h1>
<p class="email__sub" style="margin:0;font-size:14px;color:@EmailStyles.InkSoft;">@Model.Details</p>
</div>
<div class="email-facts">
@if (Model.OnYourList is { } list)
{
<div style="border-top:1px solid @EmailStyles.Line;padding-top:16px;margin-top:16px;">
<h2 class="email__section-title" style="margin:0 0 8px;font-size:14px;color:@EmailStyles.InkSoft;">On your list</h2>
<p class="email-facts__lead" style="margin:0;font-size:15px;color:@EmailStyles.Ink;"><strong>@list.Text</strong></p>
<p style="margin:4px 0 0;font-size:14px;color:@EmailStyles.InkFaint;">@list.Planned</p>
</div>
}
@if (Model.Loves.Count > 0)
{
<div style="border-top:1px solid @EmailStyles.Line;padding-top:16px;margin-top:16px;">
<h2 class="email__section-title" style="margin:0 0 8px;font-size:14px;color:@EmailStyles.InkSoft;">@Model.LovesTitle</h2>
<ul class="likes" style="margin:0;padding:0;list-style:none;">
@foreach (var love in Model.Loves)
{
<li class="likes__item" style="display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid @EmailStyles.Line;border-radius:999px;font-size:14px;color:@EmailStyles.Ink;">@love</li>
}
</ul>
</div>
}
@if (Model.LastTalk is { } talk)
{
<div style="border-top:1px solid @EmailStyles.Line;padding-top:16px;margin-top:16px;">
<h2 class="email__section-title" style="margin:0 0 8px;font-size:14px;color:@EmailStyles.InkSoft;">@talk.Heading</h2>
<p class="email-facts__lead" style="margin:0;font-size:15px;line-height:1.5;color:@EmailStyles.Ink;white-space:pre-line;">@if (talk.Title is { } title){<strong>@title</strong>@(" ")}@talk.Text</p>
</div>
}
</div>
<EmailButton Link="Model.Button" />
@if (Model.SecondButton is { } second)
{
<p style="margin:8px 0 0;"><a href="@second.Url" style="font-weight:600;font-size:15px;color:@EmailStyles.Link;">@second.Label</a></p>
}
</EmailShell>

@code {
    [Parameter, EditorRequired]
    public KeyDateReminderEmailModel Model { get; set; } = default!;
}
